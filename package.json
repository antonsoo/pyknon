{
  "name": "@antonsoloviev/pyknon",
  "version": "0.1.0",
  "private": true,
  "description": "Hear Archytas\u2019s tetrachords and discover what twelve-note rounding loses.",
  "type": "module",
  "author": "Anton Soloviev <anton@praviel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/pyknon.git"
  },
  "homepage": "https://antonsoo.github.io/pyknon/",
  "keywords": [
    "ancient-greek",
    "music-theory",
    "microtonal",
    "tetrachord",
    "web-audio",
    "education"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4329 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4329 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:ratios": "node --import tsx scripts/ratio-cases.ts | python3 scripts/ratio-oracle.py",
    "test:browser": "node scripts/browser-check.mjs",
    "verify:song": "node --import tsx scripts/song-cases.ts | python3 scripts/song-oracle.py",
    "test:song": "node scripts/song-browser.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
