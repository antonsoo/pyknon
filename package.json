{
  "name": "@antonsoloviev/pyknon",
  "version": "0.1.0",
  "private": true,
  "description": "Hear ancient Greek and Sanskrit musical arguments, operate explicit models, and read the printed evidence.",
  "type": "module",
  "author": "Anton Soloviev <anton@praviel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/pyknon.git"
  },
  "homepage": "https://antonsoo.github.io/pyknon/",
  "keywords": [
    "ancient-greek",
    "music-theory",
    "microtonal",
    "tetrachord",
    "web-audio",
    "education",
    "ptolemy",
    "monochord",
    "rhythm",
    "aristoxenus",
    "nicomachus",
    "acoustics",
    "sanskrit",
    "natyasastra",
    "bharata",
    "indian-music"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4329 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4329 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:ratios": "node --import tsx scripts/ratio-cases.ts | python3 scripts/ratio-oracle.py",
    "test:browser": "node scripts/browser-check.mjs",
    "verify:song": "node --import tsx scripts/song-cases.ts | python3 scripts/song-oracle.py",
    "test:song": "node scripts/song-browser.mjs",
    "verify:canon": "node --import tsx scripts/canon-cases.ts | python3 scripts/canon-oracle.py",
    "test:canon": "node scripts/canon-browser.mjs",
    "verify:trial": "node --import tsx scripts/trial-cases.ts | uv run --python 3.12 scripts/trial-oracle.py",
    "test:trial": "node scripts/trial-browser.mjs",
    "test:rhythm": "node scripts/rhythm-browser.mjs",
    "test:rhythm-upgrade": "node scripts/rhythm-upgrade.mjs",
    "verify:rhythm-audio": "python3 scripts/rhythm-wave-oracle.py",
    "verify:tension": "node --import tsx scripts/tension-cases.ts | python3 scripts/tension-oracle.py",
    "verify:tension-sources": "python3 scripts/tension-sources.py",
    "test:tension": "node scripts/tension-browser.mjs",
    "test:tension-upgrade": "node scripts/tension-upgrade.mjs",
    "verify:vina": "node --import tsx scripts/vina-cases.ts | python3 scripts/vina-oracle.py",
    "test:vina": "node scripts/vina-browser.mjs",
    "test:vina-integrity": "node scripts/vina-integrity.mjs",
    "test:vina-upgrade": "node scripts/vina-upgrade.mjs",
    "verify:vina-files": "python3 scripts/vina-artifacts.py",
    "verify:vina-audio": "python3 scripts/vina-wave-oracle.py",
    "verify:halves": "node --import tsx scripts/halves-cases.ts | python3 scripts/halves-oracle.py",
    "test:halves": "node scripts/halves-browser.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
